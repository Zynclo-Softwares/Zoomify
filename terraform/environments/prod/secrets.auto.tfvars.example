# Copy to secrets.auto.tfvars (gitignored) — Terraform auto-loads *.auto.tfvars on apply.
# cp secrets.auto.tfvars.example secrets.auto.tfvars
#
# Secret backend env vars — mirror root .env.example.
# Stripe payment links + STRIPE_WEBHOOK_SECRET are generated by the stripe module.
# Railway auth: export RAILWAY_TOKEN in your shell (not stored here).

secret_env_vars = {
  # Multiline PEM: use heredoc syntax, NOT raw line breaks in "quotes".
  BYOK_PRIVATE_KEY = <<-EOT
-----BEGIN PRIVATE KEY-----
...
-----END PRIVATE KEY-----
EOT

  MONGODB_URI       = "mongodb+srv://USER:PASS@cluster.mongodb.net/?retryWrites=true&w=majority"
  STRIPE_SECRET_KEY = "sk_live_..."

  # GitHub PAT — repo Issues read/write for premium schema inquiry form
  GITHUB_TOKEN = "ghp_..."
}
