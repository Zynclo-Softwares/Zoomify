# Copy to frontend/.env.local (gitignored) for Clerk sign-in in the Vite dev UI.
# Create your own Clerk application (free tier): https://clerk.com
#
# Also set the matching JWKS URL in the repo root .env:
#   CLERK_JWKS_URL=https://<your-clerk-frontend-api>/.well-known/jwks.json
#
# Without this file, make dev still works — the backend uses auth bypass when
# CLERK_JWKS_URL is unset.

VITE_CLERK_PUBLISHABLE_KEY=pk_test_...
