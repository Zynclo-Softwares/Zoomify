# LLM credentials & model selection for Zoomify.
# Copy to `.env` and fill in your key.

# Preferred: OpenRouter (supports google/gemini-3.1-flash-lite and many others)
OPENROUTER_API_KEY=
LLM_MODEL=google/gemini-3.1-flash-lite
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Fallback: direct OpenAI (used when OPENROUTER_API_KEY is unset)
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o
