# Zoomify MCP server — copy to .env (gitignored). See CONTRIBUTING.md for local setup.
#
# All keys below are OPTIONAL for local dev and self-hosting:
#   - no CLERK_JWKS_URL → no sign-in; /mcp works without a key as a "dev-local" account
#   - no MONGODB_URI    → accounts, keys, and usage are kept in memory

# --- Core (optional) ---

# Clerk JWT verification (backend). Pair with frontend/.env.local — see frontend/env.local.example.
# When set, /mcp requires a platform API key (zfy_live_…) created on the /connect page.
CLERK_JWKS_URL=

# MongoDB — users, API keys, monthly usage. In-memory store when unset.
MONGODB_URI=
MONGODB_DATABASE=Zoomify

# Public origin shown in connection snippets (defaults to the request's own origin).
# PUBLIC_BASE_URL=https://zoomify.example.com

# --- Metering ---

# Self-hosting for yourself? Switch plan limits off entirely.
# ZOOMIFY_DISABLE_QUOTAS=true

# Metered MCP requests (open_image, zoom) per minute — per account, per server process.
# Monthly allowances and defaults live in src/zoomify/account/plans.py.
# RATE_LIMIT_FREE_PER_MINUTE=20
# RATE_LIMIT_STARTER_PER_MINUTE=60
# RATE_LIMIT_PRO_PER_MINUTE=120

# Largest image accepted after decoding, in pixels (default 120 MP).
# ZOOMIFY_MAX_IMAGE_PIXELS=120000000

# --- Integrations (only when testing those features) ---

# Stripe Payment Links (client_reference_id=<clerk user id> is appended at checkout)
# Provision with: cd terraform/environments/dev && terraform apply
# Then: ./export-env.sh  or  terraform output -json env_vars
STRIPE_LINK_STARTER_MONTHLY=
STRIPE_LINK_STARTER_YEARLY=
STRIPE_LINK_PRO_MONTHLY=
STRIPE_LINK_PRO_YEARLY=

# Stripe webhook (subscription sync)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Contact form (custom skills / enterprise) — creates GitHub issues (Issues write scope)
GITHUB_TOKEN=
# GITHUB_ISSUES_REPO=Zynclo-Softwares/Zoomify
