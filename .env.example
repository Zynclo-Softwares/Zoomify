# Zoomify backend (.env)
# Generate BYOK keys once:
#   uv run python -c "from zoomify.byok_crypto import generate_keypair_pem; p,u=generate_keypair_pem(); print(p); print('---'); print(u)"

# RSA private key — decrypts encrypted OpenRouter keys from client headers
BYOK_PRIVATE_KEY=

# Clerk JWT verification (backend)
CLERK_JWKS_URL=

# MongoDB — optional; in-memory store when MONGODB_URI unset
MONGODB_URI=
MONGODB_DATABASE=Zoomify

# Stripe Payment Links (append client_reference_id=clerk_user_id at checkout)
# Provision with: cd terraform/environments/dev && terraform apply
# Then: ./export-env.sh  or  terraform output -json env_vars
STRIPE_LINK_STARTER_MONTHLY=
STRIPE_LINK_STARTER_YEARLY=
STRIPE_LINK_PRO_MONTHLY=
STRIPE_LINK_PRO_YEARLY=

# Stripe webhook (subscription sync)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Premium schema inquiries — creates GitHub issues (repo issues write scope)
GITHUB_TOKEN=
# GITHUB_ISSUES_REPO=Zynclo-Softwares/Zoomify

# Fair-use rate limits — POST /api/query requests per minute (per user, per server process)
# RATE_LIMIT_FREE_PER_MINUTE=10
# RATE_LIMIT_STARTER_PER_MINUTE=30
# RATE_LIMIT_PRO_PER_MINUTE=20

# Optional OpenRouter base URL override
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
